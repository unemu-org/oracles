# Allow-list. The default is "nothing is committed": `*` excludes everything, and only the
# paths re-included below are tracked. Whatever is vendored has to be named here, so nothing
# fetched can leak into a commit by accident.
*

# --- the reproducer and its ledger ---
!.gitignore
!fetch-oracles.sh
!MANIFEST.md
!NOTICE.md
!README.md
!LICENSE
!SHA256SUMS
!SHA256SUMS.fetched

# --- vendored sources (redistributable; see NOTICE.md for licence + attribution) ---
!amd/
!amd/kernel-*.h
!amd/kernel-*.c
!freebsd9/
!freebsd9/*
!vulkan/
!vulkan/*.adoc
!vulkan/vk.xml
!mesa/
!mesa/mesa/
!mesa/mesa/src/
!mesa/mesa/src/**
!mesa/mesa/docs/
!mesa/mesa/docs/license.rst
!mesa/mesa/licenses/
!mesa/mesa/licenses/MIT
# x86 section (serves x86jit).
!linux-x86/
!linux-x86/*
!moo/
!moo/*
!ss286/
!ss286/*
!ss8088/
!ss8088/**/
!ss8088/**/README.md
!ss8088/**/CHANGELOG.md
!ss8088/**/LICENSE
!ss8088/**/metadata.json
!ssv20/
!ssv20/**/
!ssv20/**/README.md
!ssv20/**/CHANGELOG.md
!ssv20/**/LICENSE
!ssv20/**/metadata.json
!ssv20/**/metadata.toml

# --- NEVER committed (restated after the allow-list, so it wins) ---
# AMD ISA PDFs: © AMD, no redistribution licence.
amd/*.pdf
# SPIR-V core spec: Khronos specification copyright, no clear redistribution grant.
vulkan/spirv-core.html
# x86 CPU manuals: © Intel / © AMD, no redistribution licence.
intel/*.pdf
# x86-64 psABI: the upstream repository carries no licence file at all.
psabi/
# OpenOrbis clone: fetch-only (169 MB, and the provenance quarantine modifies it).
openorbis/
# Upstream scratch clones used by `fetch` and `verify --upstream`.
.upstream/
# A nested clone must never turn the vendored tree into a gitlink.
mesa/mesa/.git/
# Local tool version record.
llvm-mc.version
